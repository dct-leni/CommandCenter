{
  "manifest_version": 2,
  "name": "CommandCenter Firefox Tab Audio",
  "version": "1.0",
  "description": "Captures tab audio and streams PCM over WebSocket to CommandCenter live stream engine.",
  "applications": {
    "gecko": {
      "id": "tab-audio@commandcenter"
    }
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
