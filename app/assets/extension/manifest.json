{
  "manifest_version": 2,
  "name": "Visibility Override",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "visibility@commandcenter.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}